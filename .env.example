# Public integration endpoint configuration (safe to use in Expo client builds)
EXPO_PUBLIC_REDDIT_PUBLIC_JSON=true
EXPO_PUBLIC_APP_STORE_LOOKUP=true
# Leave unset in production: the web build calls the same-origin review collector.
# Set to http://localhost:3001 only for local development against a separate server.
EXPO_PUBLIC_REVIEW_API_URL=
REVIEW_COLLECTOR_PORT=3001


LINKEDIN_CLIENT_SECRET=
LINKED# Comment translation uses the google-translate-api-x package: no API key or extra service needed.

# Server-only credentials — configure in a backend or secret vault, never in EXPO_PUBLIC variables
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Optional: Google PageSpeed Insights API key. When set, the Website rating
# blends live site checks 50/50 with Google Lighthouse (mobile strategy).
GOOGLE_PAGESPEED_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
LINKEDIN_CLIENT_ID=IN_ACCESS_TOKEN=
TWITTER_BEARER_TOKEN=
TRUSTPILOT_API_KEY=
TRUSTPILOT_API_SECRET=
REVIEWS_IO_API_KEY=
REVIEWS_IO_PRIVATE_KEY=

# Social review feeds (server-side only)
FACEBOOK_PAGE_ID=
LINKEDIN_ORGANIZATION_URN=
REVIEWS_IO_STORE=
# Optional Scrapy service for public pages: python scraper/app.py
SCRAPY_SERVICE_URL=http://localhost:8001
SCRAPY_SERVICE_PORT=8001
REVIEWS_IO_PUBLIC_URL=
