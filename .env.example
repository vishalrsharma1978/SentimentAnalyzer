# Public integration endpoint configuration (safe to use in Expo client builds)
EXPO_PUBLIC_REDDIT_PUBLIC_JSON=true
EXPO_PUBLIC_APP_STORE_LOOKUP=true
# Leave unset in production: the web build calls the same-origin review collector.
# Set to http://localhost:3001 only for local development against a separate server.
EXPO_PUBLIC_REVIEW_API_URL=
REVIEW_COLLECTOR_PORT=3001

# Server-side local LibreTranslate service (no API key required for self-hosting)
LIBRETRANSLATE_URL=http://127.0.0.1:5000

# Server-only credentials — configure in a backend or secret vault, never in EXPO_PUBLIC variables
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
TWITTER_BEARER_TOKEN=
TRUSTPILOT_API_KEY=
TRUSTPILOT_API_SECRET=
REVIEWS_IO_API_KEY=
REVIEWS_IO_PRIVATE_KEY=
